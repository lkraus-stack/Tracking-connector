# Admin app
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# Airbyte self-managed / OSS Public API
AIRBYTE_API_URL=http://localhost:8000
AIRBYTE_API_TOKEN=

# Supabase Admin metadata and Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=

# BigQuery reporting target
BIGQUERY_PROJECT_ID=
BIGQUERY_LOCATION=EU
BIGQUERY_RAW_DATASET=airbyte_raw
BIGQUERY_REPORTING_DATASET=marketing_reporting
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_MOCK=true

# Optional local Airbyte installer flags for scripts/setup-airbyte-abctl.sh
AIRBYTE_HOST=localhost
AIRBYTE_LOW_RESOURCE=false
AIRBYTE_INSECURE_COOKIES=false
