{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "paths": {
      "@/*": ["./apps/admin/src/*"],
      "@tracking-connector/airbyte": ["./packages/airbyte/src/index.ts"],
      "@tracking-connector/bigquery": ["./packages/bigquery/src/index.ts"],
      "@tracking-connector/shared": ["./packages/shared/src/index.ts"]
    }
  }
}
